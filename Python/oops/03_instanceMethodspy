class Laptop:
    storage_type  = "ssd"

    def __init__(self , RAM , storage):
        self.RAM = RAM
        self.storage = storage 

    def get_info(self): #instance method
        print(f"The laptop has {self.RAM} RAM & {self.storage} {self.storage_type}")

