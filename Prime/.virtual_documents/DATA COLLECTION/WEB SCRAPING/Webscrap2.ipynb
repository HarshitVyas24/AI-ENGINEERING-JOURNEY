# SCRAPING HTML DATA

import requests


headers = {
    "User-Agent" : "Mozilla/5.0"
}

for i in range(1,11):
        
    with open(f"scraped_data/quotesPage{i}.html" , "w" , encoding = "utf-8") as f:
        try:
            res = requests.get(f"https://quotes.toscrape.com/page/{i}/" , headers = headers)
            res.raise_for_status()
            f.write(res.text)
            
        except requests.exceptions.RequestException as e:
            print("Error: " , e)


