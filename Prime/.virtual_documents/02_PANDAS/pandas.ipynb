# AQI DATASET

df = pd.read_csv("globalAirQuality.csv")

df.head()
df.describe()


#Selecting the Data\

#column selection
df["city"]
df[["city", "aqi"]]


#Row selection
df.loc[2]
df.loc[0:2]   # start dx : end index(inclusive)

df.iloc[2]
df.iloc[0:2]  # start idx : end idx (exclusive)

# cells - row, col
df.loc[0 , "aqi"]

df.loc[0, ["aqi" , "city"]]

df.loc[0:2 , ["city" , "aqi"]]

df.columns  # give all columns 

#df.iloc(0:2 , "city") # throws error since city is string so we need to passs city index

df.iloc[0:2 , 2]

df.loc[0:2 , ["aqi", "city", "latitude", "longitude"]]

df.iloc[0:3 , 0:4]


# cell
df.at[0, "city"]
df.iat[0 , 2]


# VIEW NOT COPY

cities = df["city"].copy()  # view of original data but using .copy() make a copy of original data

cities[0] = "Mumbai"  # Changes the Original data

cities


# Filtering of Data

df[ df["aqi"] > 100 ]

df[ (df["aqi"] > 100) & (df["temperature"] > 30)]

# we can do chaining as well

aqi_data = df[  (df["aqi"] > 100) & (df["temperature"] > 30) ] [["city" , "aqi"]]

aqi_data
aqi_data.iloc[0]
#aqi_data.loc[0]   # throws error since label 0 do not exist in data this shows how lable and index differs
aqi_data.loc[6] #gives correct result



#query
aqi_val = 100
df.query("aqi > 100 & temperature > 30" )[["city", "aqi"]]

aqi_data = df.query("aqi > @aqi_val & temperature > 30" )[["city", "aqi"]].copy()



df


